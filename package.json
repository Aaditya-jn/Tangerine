{
  "name": "tangerine-linux",
  "version": "0.3.0",
  "description": "Drag-to-convert desktop app for Linux",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist":  "electron-builder --linux AppImage"
  },
  "author": "Aaditya Jain",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.tangerine.linux",
    "productName": "Tangerine",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "assets/icon.png",
      "executableName": "tangerine"
    },
    "appImage": {
      "artifactName": "Tangerine-${version}.AppImage"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
